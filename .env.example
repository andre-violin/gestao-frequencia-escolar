# ========================================
# CONFIGURAÇÃO DO BANCO DE DADOS
# ========================================

# URL de conexão do MongoDB
# Formato: mongodb://[usuário]:[senha]@[host]:[porta]/[database]?[opções]
# 
# Exemplos:
# - MongoDB Local: mongodb://localhost:27017/sigefe
# - MongoDB Atlas: mongodb+srv://usuario:senha@cluster.mongodb.net/sigefe?retryWrites=true&w=majority
#
# IMPORTANTE: Substitua pela sua connection string real!
DATABASE_URL="mongodb://localhost:27017/sigefe"

# ========================================
# CONFIGURAÇÃO DO SERVIDOR
# ========================================

PORT=3000
NODE_ENV=development
